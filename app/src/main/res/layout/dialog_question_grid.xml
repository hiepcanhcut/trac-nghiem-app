<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvGridTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bảng câu hỏi"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Đã làm"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="● Đánh dấu"
            android:textColor="@color/quiz_yellow"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="● Chưa làm"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <GridView
        android:id="@+id/gridViewQuestions"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="16dp"
        android:horizontalSpacing="8dp"
        android:numColumns="5"
        android:verticalSpacing="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitFromGrid"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/quiz_green"
        android:text="Nộp bài ngay"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
